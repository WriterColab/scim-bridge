# scim-bridge global configuration.
# Copy to .env and adjust. Per-directory settings (your native SCIM endpoint,
# the WorkOS directory endpoint, tokens, and migration mode) are NOT set here —
# you import each directory through the control panel at /panel.

# --- Role ---------------------------------------------------------------------

# Which half of a migration this container runs. "bridge" (the default) is the
# product: the migration proxy plus the control panel. "native-app" serves only
# the bundled native app — its SCIM server, DSync listener, and status page at
# the root — so the same image can stand in for the customer's own application
# in an end-to-end run. See docs/runbook.md; the NATIVE_APP block below only
# applies in that role.
APP_ROLE=bridge

# --- Networking --------------------------------------------------------------

# Port the server listens on inside the container.
PORT=8080

# Public base URL your IdP uses to reach the proxy. The control panel shows
# "<PUBLIC_URL>/scim/v2" as the SCIM base URL to paste into your IdP.
# Set this to the externally reachable URL (behind your TLS terminator).
# Example: https://scim-bridge.acme.com
PUBLIC_URL=http://localhost:8080

# --- Storage -----------------------------------------------------------------

# Which datastore backs the container.
#   sqlite   (default, recommended) one file at DATABASE_PATH. Point it at a
#            MOUNTED VOLUME: the file holds every directory, its migration mode
#            and its id mappings, and a container's own disk does not survive
#            being replaced. Boot warns when the path is on overlay/tmpfs.
#   postgres RDS/Aurora or any Postgres, via DATABASE_URL. For more than one
#            instance, managed backups/PITR, or if you would rather point at a
#            database than mount a filesystem.
# See docs/runbook.md#durable-storage — including what recovery costs.
# Run ONE instance against either: the proxy serialises writes per directory and
# the DSync listener's dedup assumes a single writer.
DATABASE_DRIVER=sqlite

# Path to the SQLite database file (DATABASE_DRIVER=sqlite). Mount a volume here
# so data survives restarts (the container defaults this to /data/scim-bridge.db).
DATABASE_PATH=/data/scim-bridge.db

# Connection string (DATABASE_DRIVER=postgres). Required in that mode; the
# container refuses to start without it.
# Example: postgres://bridge:secret@scim-bridge-db.abc.eu-west-1.rds.amazonaws.com:5432/bridge
DATABASE_URL=

# --- Security ----------------------------------------------------------------

# REQUIRED. HTTP Basic credentials protecting the control panel. The bridge
# refuses to start without them, because /panel renders each directory's native
# and WorkOS bearer tokens into the page — an unauthenticated panel hands out the
# credentials this bridge writes to your app and to WorkOS with. Encrypting them
# at rest (below) does not change that: the panel decrypts to render.
#
# Set BOTH or neither — a username with a blank password denies every request,
# including yours, so the bridge refuses to start on half a pair too.
#
# The /scim data-plane is authenticated separately, by each directory's own proxy
# token, so these do not gate it.
PANEL_AUTH_USER=
PANEL_AUTH_PASSWORD=

# Set to true ONLY if something in front of the bridge already authenticates
# /panel — a reverse proxy, an SSO forward-auth, a private network with nothing
# else on it. It is the explicit way to run the panel open; leaving the two
# variables above blank is not.
PANEL_AUTH_DISABLED=false

# Panel mutations (save endpoints, change mode, run backfill, delete) are refused
# unless the request is same-origin — the browser's Origin / Sec-Fetch-Site prove
# it came from the panel itself, not a cross-site page forging it with the
# operator's cached Basic credentials. Set to true ONLY to drive the panel from a
# non-browser client or another origin (a script); it turns that protection off.
PANEL_CSRF_DISABLED=false

# Set to true when every request reaches the bridge through a TLS-terminating
# reverse proxy you run (ingress, load balancer, Tailscale). The proxy's
# X-Forwarded-Proto: https then marks the request as https, which panel actions
# need: React Router refuses an https Origin on an http request with 400. Leave
# false when clients can reach the container directly.
TRUST_PROXY=false

# Optional. When set, each directory's native + WorkOS bearer tokens are
# encrypted at rest (AES-256-GCM). Keep it stable — rotating or removing it
# leaves existing encrypted tokens unreadable. Leave blank to store plaintext.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Customer-app stand-in (APP_ROLE=native-app only) ------------------------

# Bearer token this app requires on its own /scim/v2 — the same value you set as
# the directory's native token on the bridge. Leave blank to keep the random one
# the database seeds (read it back from poc_config: native.scim_token).
NATIVE_SCIM_TOKEN=

# REQUIRED in this role. Signing secret of the WorkOS webhook endpoint that
# delivers Directory Sync events to <PUBLIC_URL>/webhooks/dsync (WorkOS dashboard
# → Webhooks). Every delivery is HMAC-verified against it; the container refuses
# to start without one rather than accept unsigned deliveries on a public URL.
WEBHOOK_SECRET=

# Base URL of the BRIDGE container. The listener reads each directory's
# migration mode from "<BRIDGE_STATUS_URL>/status/directories/{id}" to decide
# whether to apply an event; unset, it can't reach the bridge and stays inert.
# Example: https://scim-bridge.acme.com
BRIDGE_STATUS_URL=

# Optional. WorkOS API key (sk_...). When set, the DSync listener POLLS the
# WorkOS Events API (GET /events) instead of depending on webhook delivery
# order: the API returns events IN ORDER behind a cursor, so a stale event can
# never arrive after the newer one it supersedes — the failure mode webhooks
# have. Polled events go through the exact same handling as webhook deliveries
# (duplicates are dropped by event id), so both can run at once.
# This is an ENVIRONMENT-WIDE credential, broader than anything else this app
# holds: keep it in your secret manager. Unset, the poller is off and webhooks
# remain the transport — except in DEMO_MODE, which needs no key (see below).
# The demo panel's DSync listener tab can store a key instead (encrypted at
# rest when APP_ENCRYPTION_KEY is set, never rendered back); this environment
# variable ALWAYS takes precedence over a key stored there.
WORKOS_API_KEY=

# Base URL of the Events API. Leave the default for real WorkOS. In DEMO_MODE
# the demo self-wires instead: unset, this defaults to the mock WorkOS the demo
# bridge itself mounts (http://127.0.0.1:<PORT>/__demo/native/mock-workos) and
# the poller runs with NO WORKOS_API_KEY, authenticating with the mock's own
# seeded token — zero-config, like the rest of the demo. Keyless polling works
# only against that bundled mock; any other URL requires the real key.
WORKOS_EVENTS_URL=https://api.workos.com

# How often the poller asks for new events, in milliseconds.
WORKOS_EVENTS_POLL_INTERVAL_MS=5000

# The directories this app serves, as JSON. Per directory: the WorkOS directory
# id its DSync events carry, and that directory's proxy token from the bridge
# (the listener presents it to the status endpoint). "name" is optional and only
# labels the status page. This is the authoritative set: each boot reconciles the
# stored rows against it, so a directory you drop from here stops resolving
# events (and releases its token) on the next restart.
# Example: [{"workos_directory_id":"directory_01HXYZ","proxy_token":"…","name":"Acme"}]
DIRECTORIES_JSON=

# --- Demo --------------------------------------------------------------------

# Set to true to mount the bundled IdP + native-app simulators under /__demo
# and drive a full end-to-end migration with no real IdP or WorkOS account.
# Leave false in production.
DEMO_MODE=false
