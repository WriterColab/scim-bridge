# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest

# react-router build output
/build/
/.react-router/

# local SQLite data
/data/
*.db
*.db-wal
*.db-shm

# misc
.DS_Store
*.pem
gha-creds-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committed as the template)
.env*
!.env.example

# Local Cloudflare secrets. `wrangler dev` reads .dev.vars, and deploy/cloudflare's
# README tells operators to put their panel password and DIRECTORIES_JSON there —
# which carries every directory's proxy token, so it must never be committed.
.dev.vars
.dev.vars.*

# typescript
*.tsbuildinfo

.claude/settings.local.json
.localdata/
